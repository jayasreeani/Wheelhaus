{
  "name": "weelhaus-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite --port 5173",
    "start:backend": "tsx apps/backend-api/src/server.ts",
    "start:customer": "npm run start --prefix apps/customer-mobile",
    "start:partner": "npm run start --prefix apps/partner-mobile",
    "start:admin": "npm run dev --prefix apps/admin-web",
    "build:all": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "tsx": "^4.23.15"
  }
}
